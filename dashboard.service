[Unit]
Description=Discord Project Tracker dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/discord-project-tracker
EnvironmentFile=/etc/tracker-dashboard.env
ExecStart=/usr/bin/python3 dashboard.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
